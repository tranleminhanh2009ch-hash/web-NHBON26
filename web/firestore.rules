rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function coursePublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.published == true;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
      match /progress/{lessonId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /courses/{courseId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if signedIn() && (coursePublished(courseId) || isAdmin());
        allow create, update, delete: if isAdmin();
        match /lessons/{lessonId} {
          allow read: if signedIn() && (coursePublished(courseId) || isAdmin());
          allow create, update, delete: if isAdmin();
          match /sessions/{sessionId} {
            allow read: if signedIn() && (coursePublished(courseId) || isAdmin());
            allow create, update, delete: if isAdmin();
            match /materials/{materialId} {
              allow read: if signedIn() && (coursePublished(courseId) || isAdmin());
              allow create, update, delete: if isAdmin();
            }
          }
        }
      }
    }
  }
}
